{
  "manifest_version": 2,
  "name": "Thunderbird Translator",
  "version": "1.7.0",
  "description": "Translate emails using Ollama, Google Translate or LibreTranslate",
  "author": "jctots (fork of zoott28354)",
  "default_locale": "en",

  "browser_specific_settings": {
    "gecko": {
      "id": "translator@thunderbird-addon",
      "strict_min_version": "128.0"
    }
  },

  "permissions": [
    "messagesRead",
    "messagesModify",
    "compose",
    "storage",
    "tabs",
    "*://*/*"
  ],

  "message_display_action": {
    "default_title": "Translate",
    "default_icon": "icons/translate-48.png",
    "default_popup": "popup/popup.html"
  },

  "compose_action": {
    "default_title": "Translate",
    "default_icon": "icons/translate-48.png",
    "default_popup": "popup/popup.html"
  },

  "background": {
    "scripts": ["background.js"]
  },

  "options_ui": {
    "page": "options/options.html"
  },

  "icons": {
    "48": "icons/translate-48.png",
    "96": "icons/translate-96.png"
  }
}
